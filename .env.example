# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adpilot?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-prod"

# OpenAI
OPENAI_API_KEY="sk-your-openai-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PRICE_ID_STARTER="price_starter_123"
STRIPE_PRICE_ID_GROWTH="price_growth_123"
STRIPE_PRICE_ID_AGENCY="price_agency_123"
STRIPE_PRICE_ID_ENTERPRISE="price_enterprise_123"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="adpilot-reports"

# Google Ads
GOOGLE_ADS_CLIENT_ID="your_google_ads_client_id"
GOOGLE_ADS_CLIENT_SECRET="your_google_ads_client_secret"
GOOGLE_ADS_REDIRECT_URI="http://localhost:3000/api/v1/integrations/google-ads/oauth/callback"
GOOGLE_ADS_DEVELOPER_TOKEN="your_google_ads_developer_token"

# Meta Ads
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3001"

# Port
PORT=3000